# Copy to .env and fill in. Never commit .env.

# App under test (Laragon vhost). The session cookie is bound to the app's COOKIE_DOMAIN,
# so use that host, and set SESSION_COOKIE_SECURE=false in the app for plain http.
# For the PHP dev server (E2E_START_SERVER) use http://tpp.localhost:8765 with COOKIE_DOMAIN=tpp.localhost.
BASE_URL=http://tdpmobile2.localhost

# Main test account (used by the "app" and "session" projects).
# Use a user that logs in without an emailed OTP: either 2FA off, or the authenticator
# method with its key in E2E_USER_TOTP_SECRET. Email OTP can't be automated.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# Base32 key shown under "Can't scan? Enter this key instead" during authenticator setup.
E2E_USER_TOTP_SECRET=
# master | normal | viewer  (controls which role-specific checks run)
E2E_USER_ROLE=master

# Second account for the two-factor project (authenticator method, already set up).
# Must differ from the main account: logging in ends that user's other sessions.
E2E_2FA_EMAIL=
E2E_2FA_PASSWORD=
E2E_2FA_TOTP_SECRET=
# Optional: one unused backup code (XXXX-XXXX). It is used up by the test; replace it after each run.
E2E_2FA_BACKUP_CODE=

# Hosts the suite may run against (comma-separated). It places real orders, so any other
# BASE_URL host aborts the run. Never add a production host.
E2E_ALLOWED_HOSTS=tdpmobile2.localhost,tpp.localhost,127.0.0.1,localhost

# Ordering: one attraction id per case (tests for an empty id are skipped).
# Open-dated settlement ticket (also used by the original booking spec).
E2E_ATTR_SETTLEMENT=
# Fixed-date tickets (pricing_type fdate).
E2E_ATTR_FDATE=
# Fixed date + time slot (pricing_type fdatetime).
E2E_ATTR_FDATETIME=
# Two-way trip (pricing_type two_way_fdatetime).
E2E_ATTR_TWO_WAY=
# An attraction whose tickets have booking questions (traveller / pickup details).
E2E_ATTR_QUESTIONS=
# Optional: a second bookable attraction, for carts with two attractions.
E2E_ATTR_SECOND=
# Legacy name for E2E_ATTR_SETTLEMENT.
E2E_ATTRACTION_ID=
# Purchase matrix: file with one ticket per pricing × type × voucher combination (default matrix.json,
# built by scripts/build-matrix.php). E2E_MATRIX_DB_URL: DB of the site BASE_URL points at, for the build.
E2E_MATRIX_FILE=
E2E_MATRIX_DB_URL=
# Optional, YYYY-MM-DD: date to pick for dated tickets (defaults to the first enabled day in the picker).
E2E_TICKET_DATE=

# Online payment methods enabled on the target (pay_by values from the confirmation page,
# e.g. credit_card,paynow). Tests go up to the gateway page only; nothing is charged.
E2E_PAYMENT_METHODS=

# Optional extra accounts (same agent as the main account unless noted).
# A normal (non-master) user, for "who sees which orders" checks.
E2E_NORMAL_EMAIL=
E2E_NORMAL_PASSWORD=
E2E_NORMAL_TOTP_SECRET=
# A user whose agent has fewer credits than one ticket costs (insufficient-credit checks).
E2E_LOW_CREDIT_EMAIL=
E2E_LOW_CREDIT_PASSWORD=
E2E_LOW_CREDIT_TOTP_SECRET=

# Side effects are off by default. Orders placed are listed in test-results/orders.jsonl.
# true = actually pay with agent credits (creates a real order and spends credits).
E2E_ALLOW_PURCHASE=false
# true = submit the Contact Us form (sends an email to the configured contact address).
E2E_ALLOW_EMAIL=false
# true = cancel a voucher of an order placed by this run.
E2E_ALLOW_CANCEL=false
# true = generate a Sales Report (runs the report command on the server).
E2E_ALLOW_REPORTS=false
# true = submit a top-up request with a small test image.
E2E_ALLOW_TOPUP=false
# true = add, edit and suspend a throwaway agent sub-user, reset its password / two-factor.
E2E_ALLOW_USER_ADMIN=false
# true = change the main account's password and change it back.
E2E_ALLOW_PASSWORD_CHANGE=false

# Optional: let Playwright start the PHP dev server itself.
E2E_START_SERVER=false
APP_DIR=..
PHP_BIN=C:/laragon/bin/php/php-8.5.12-nts-Win32-vs17-x64/php.exe
