{
  "name": "tdpmobile2-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for the tdpmobile2 B2B agent portal",
  "scripts": {
    "test": "playwright test",
    "test:public": "playwright test --project=public",
    "test:app": "playwright test --project=app",
    "test:2fa": "playwright test --project=two-factor",
    "test:mobile": "playwright test --project=mobile-public --project=mobile",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://tdpmobile2.localhost/agent-users/login",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
